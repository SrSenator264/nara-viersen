(() => {
  'use strict';

  const $ = (s, root = document) => root.querySelector(s);
  const $$ = (s, root = document) => [...root.querySelectorAll(s)];
  const esc = value => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const euro = cents => new Intl.NumberFormat('de-DE', {style:'currency', currency:'EUR'}).format((Number(cents)||0)/100);
  const source = typeof catalog !== 'undefined' && Array.isArray(catalog) ? catalog : [];
  const products = source.filter(p => !p.hidden && !p.unavailable);
  let category = products[0]?.c || '';
  let searchTerm = '';
  let cart = [];
  let pending = null;

  function productText(p) { return `${p.n || ''} ${p.d || ''} ${p.c || ''}`.toLocaleLowerCase('de'); }
  function optionGroups(p) {
    const options = Array.isArray(p.dips) ? p.dips.filter(o => !o.unavailable) : [];
    const names = p.requiredGroups?.length ? p.requiredGroups : [...new Set(options.map(o => o.group).filter(Boolean))];
    return names.map(group => ({group, options: options.filter(o => o.group === group)})).filter(g => g.options.length);
  }
  function selectedOptions() { return pending?.chosen || []; }
  function chosenFor(group, id) { return selectedOptions().find(o => o.group === group && o.id === id); }
  function optionCost(o, qty = 1) { return (Number(o.cents) || 0) * qty; }

  function render() {
    const categories = [...new Set(products.map(p => p.c).filter(Boolean))];
    $('#categories').innerHTML = categories.map(c => `<button class="category ${c === category ? 'selected' : ''}" data-category="${esc(c)}">${esc(c)}</button>`).join('');
    const list = searchTerm ? products.filter(p => productText(p).includes(searchTerm)) : products.filter(p => p.c === category);
    $('#item-count').textContent = searchTerm ? `${list.length} نتائج بحث` : `${list.length} أصناف`;
    $('#products').innerHTML = list.map(p => `<button class="product" data-product="${esc(p.id)}"><span class="product-name">${esc(p.n)}</span><span class="product-desc">${esc(p.d || '')}</span><b>${euro(p.cents)}</b></button>`).join('') || '<p class="cart-empty">لا توجد أصناف مطابقة</p>';
    renderCart();
  }

  function renderCart() {
    $('#cart').className = cart.length ? '' : 'cart-empty';
    $('#cart').innerHTML = cart.length ? cart.map((item, index) => `<article class="cart-item"><div><strong>${esc(item.name)}</strong><small>${item.options.map(o => `${esc(o.name)}${o.quantity > 1 ? ` × ${o.quantity}` : ''}`).join(' · ')}</small>${item.note ? `<small>ملاحظة: ${esc(item.note)}</small>` : ''}<span>${euro(item.unitCents)} × ${item.quantity}</span></div><div class="cart-controls"><button data-act="minus" data-index="${index}">−</button><b>${item.quantity}</b><button data-act="plus" data-index="${index}">+</button><button class="remove" data-act="remove" data-index="${index}">حذف</button></div></article>`).join('') : 'اختر صنفًا من المنيو لإضافته';
    $('#total').textContent = euro(cart.reduce((sum, item) => sum + item.unitCents * item.quantity, 0));
  }

  function openProduct(p) {
    const groups = optionGroups(p);
    if (!groups.length) return addToCart(p, []);
    pending = {p, chosen: [], note: ''};
    $('#modal-title').textContent = p.n;
    $('#item-note').value = '';
    $('#modifier-groups').innerHTML = groups.map(g => `<fieldset class="modifier-group"><legend>${esc(g.group)}</legend>${g.options.map(o => `<label class="option"><input type="checkbox" data-group="${esc(g.group)}" data-option="${esc(o.id || o.name)}" data-name="${esc(o.name)}" data-cents="${Number(o.cents)||0}"><span>${esc(o.name)}</span><b>${Number(o.cents) ? '+' + euro(o.cents) : 'inklusive'}</b></label>`).join('')}</fieldset>`).join('');
    $('#modifier-modal').hidden = false;
  }

  function addToCart(p, options, note = '') {
    const unitCents = (Number(p.cents) || 0) + options.reduce((sum, o) => sum + optionCost(o, o.quantity || 1), 0);
    cart.push({id: `${p.id}-${Date.now()}`, name: p.n, unitCents, quantity: 1, options, note});
    $('#message').textContent = 'تمت إضافة الصنف إلى الطلب.';
    renderCart();
  }

  $('#categories').onclick = e => { const b = e.target.closest('[data-category]'); if (b) { category = b.dataset.category; searchTerm = ''; $('#menu-search').value = ''; render(); } };
  $('#products').onclick = e => { const b = e.target.closest('[data-product]'); if (b) { const p = products.find(item => String(item.id) === b.dataset.product); if (p) openProduct(p); } };
  $('#menu-search').oninput = e => { searchTerm = e.target.value.trim().toLocaleLowerCase('de'); const match = products.find(p => productText(p).includes(searchTerm)); if (searchTerm && match) category = match.c; render(); };
  $('#modifier-groups').onchange = e => { const input = e.target; if (!input.matches('input')) return; const group = input.dataset.group; pending.chosen = pending.chosen.filter(o => !(o.group === group && o.id === input.dataset.option)); if (input.checked) pending.chosen.push({id: input.dataset.option, name: input.dataset.name, cents: Number(input.dataset.cents)||0, group, quantity: 1}); };
  $('#add-configured').onclick = () => { if (!pending) return; addToCart(pending.p, pending.chosen, $('#item-note').value.trim()); pending = null; $('#modifier-modal').hidden = true; };
  $('#close-modal').onclick = () => { pending = null; $('#modifier-modal').hidden = true; };
  $('#cart').onclick = e => { const b = e.target.closest('[data-act]'); if (!b) return; const i = cart[Number(b.dataset.index)]; if (!i) return; if (b.dataset.act === 'plus') i.quantity++; if (b.dataset.act === 'minus') i.quantity--; if (b.dataset.act === 'remove' || i.quantity < 1) cart.splice(Number(b.dataset.index), 1); renderCart(); };
  $('#clear-cart').onclick = () => { cart = []; renderCart(); $('#message').textContent = 'تم تفريغ الطلب.'; };
  [['print','تم فتح الطباعة التجريبية فقط.'],['kitchen','تم تجهيز إرسال تجريبي للمطبخ.'],['cash','تم اختيار Cash — لا توجد معاملة مالية.'],['card','تم اختيار Karte — لا توجد معاملة مالية.']].forEach(([id, message]) => { const button = $('#' + id); if (button) button.onclick = () => $('#message').textContent = message; });
  render();
})();
