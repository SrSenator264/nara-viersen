:root{--fire:#ef491d;--ink:#20231f;--paper:#f8f5ea;--muted:#62675f;--line:#dce0d7}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 Tahoma,Arial,sans-serif}button{font:inherit;cursor:pointer;border:0}button:focus-visible{outline:3px solid #286bc1}.warning{background:#74220d;color:#fff;text-align:center;padding:12px;font-weight:700}header{display:flex;align-items:center;gap:28px;padding:16px 4%;background:#fff;border-bottom:1px solid var(--line)}header a:last-child{margin-right:auto}.brand{font:bold 28px Arial;text-decoration:none;color:var(--fire)}main{max-width:1500px;margin:auto;padding:24px}.toolbar,.section-head{display:flex;justify-content:space-between;align-items:center;gap:12px}.eyebrow{color:var(--fire);font-weight:bold;font-size:12px}h1{font-size:32px;margin:2px 0}h2{margin:0}.status{background:#fff0e4;padding:10px;border-radius:8px}.cashier-layout{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(340px,.85fr);gap:20px;align-items:start}.panel{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px}.categories{display:flex;gap:10px;overflow:auto;padding:15px 0}.category,.ghost{background:#eef0e9;border:1px solid var(--line);border-radius:9px;padding:13px 18px;min-height:52px;white-space:nowrap;font-weight:bold}.category.selected{background:var(--ink);color:#fff}.products{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px}.product{min-height:145px;text-align:right;background:#fffaf1;border:1px solid #eadfce;border-radius:12px;padding:15px;display:flex;flex-direction:column;gap:6px}.product-name{font-weight:800;font-size:18px}.product-desc{color:var(--muted);font-size:13px;flex:1}.product b{font-size:19px;direction:ltr}.cart-panel{position:sticky;top:12px}.cart-empty{text-align:center;color:var(--muted);padding:45px 10px}.cart-item{border-bottom:1px solid var(--line);padding:12px 0;display:flex;justify-content:space-between;gap:10px}.cart-item strong,.cart-item small,.cart-item span{display:block}.cart-item small{color:var(--muted);font-size:12px}.cart-controls{display:flex;align-items:center;gap:6px}.cart-controls button{background:#eef0e9;border-radius:7px;min-width:42px;min-height:42px;font-size:22px}.cart-controls .remove{font-size:13px;color:#952800}.cart-total{border-top:2px solid var(--ink);margin-top:14px;padding-top:14px;display:flex;justify-content:space-between;font-size:22px}.pay-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}.pay-actions button{min-height:58px;border-radius:9px;font-weight:800}.secondary{background:#eef0e9}.cash{background:#2f7d4a;color:#fff}.card{background:#286bc1;color:#fff}.message{color:#952800;font-weight:bold}.modal{position:fixed;inset:0;background:#0008;display:grid;place-items:center;padding:16px}.modal[hidden]{display:none}.modal-card{background:#fff;border-radius:14px;padding:22px;width:min(620px,100%);max-height:90vh;overflow:auto}.option{display:block;padding:12px;border-bottom:1px solid #eee}.add-configured{width:100%;background:var(--fire);color:#fff;border-radius:9px;padding:15px;font-weight:bold}footer{text-align:center;color:var(--muted);padding:24px}@media(max-width:900px){.cashier-layout{grid-template-columns:1fr}.cart-panel{position:static}.toolbar{align-items:start;flex-direction:column}}@media(max-width:600px){main{padding:14px}.products{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.product{min-height:150px;padding:11px}header{gap:12px;flex-wrap:wrap}}
.menu-search{display:block;width:100%;box-sizing:border-box;margin:0 0 14px;padding:14px 18px;border:1px solid #d8d5ca;border-radius:14px;background:#fff;color:#1f2933;font:inherit;font-size:1.05rem;outline:none;direction:rtl}.menu-search:focus{border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.14)}.menu-search::placeholder{color:#7b8490}
